# Copy to .env and fill in. Never commit .env.
# Required
ROBOFLOW_API_KEY=your_roboflow_private_api_key

# Optional: default workspace slug so tools don't need it every call
ROBOFLOW_WORKSPACE=

# Optional: override the API base if you proxy Roboflow
ROBOFLOW_API_URL=https://api.roboflow.com

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
ROBOFLOW_MCP_LOG_LEVEL=INFO

# Optional: browser-session Cookie header from a logged-in app.roboflow.com
# tab (DevTools -> Network). Only needed by roboflow_add_reviewed_to_dataset,
# which replays the web app's internal "Add to Dataset" endpoint because
# Roboflow has no public API for it. Full-account credential; expires.
ROBOFLOW_SESSION_COOKIE=

# Optional: override the app host used by session-cookie tools
ROBOFLOW_APP_URL=https://app.roboflow.com
